{
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "api/index.ts",
      "use": "@vercel/node"
    },
    {
      "src": "api/health.ts",
      "use": "@vercel/node"
    },
    {
      "src": "api/shared/auth/login.ts",
      "use": "@vercel/node"
    },
    {
      "src": "api/shared/auth/session.ts",
      "use": "@vercel/node"
    },
    {
      "src": "api/shared/auth/logout.ts",
      "use": "@vercel/node"
    },
    {
      "src": "api/shared/auth/keep-alive.ts",
      "use": "@vercel/node"
    }
  ],
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "routes": [
    { "src": "/api/health", "dest": "/api/health.ts" },
    { "src": "/api/shared/auth/login", "dest": "/api/shared/auth/login.ts" },
    { "src": "/api/shared/auth/session", "dest": "/api/shared/auth/session.ts" },
    { "src": "/api/shared/auth/logout", "dest": "/api/shared/auth/logout.ts" },
    { "src": "/api/shared/auth/keep-alive", "dest": "/api/shared/auth/keep-alive.ts" },
    { "src": "/api/(.*)", "dest": "/api/index.ts" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
