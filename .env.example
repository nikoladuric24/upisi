# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# e-Dnevnik authentication API used so e-Upisi accepts the same login data.
# Set this in Vercel to the real deployed e-Dnevnik base URL.
EDNEVNIK_AUTH_BASE_URL=https://e-dnevnik.skolehr.xyz

# Optional: force local/dev portal mode when testing on localhost.
# FACULTY_ADMISSIONS = postani-student.skolehr.xyz
# SECONDARY_ADMISSIONS = e-srednja.skolehr.xyz
LOCAL_PORTAL_TYPE="FACULTY_ADMISSIONS"

# E-MATICA INTEGRATION CONFIGURATION
EMATICA_BASE_URL=https://e-matica.skolehr.xyz
EMATICA_SERVICE_CLIENT_ID=eduportal_mzo_client
EMATICA_SERVICE_SECRET=secure_mzo_ematica_secret_key_2026
EMATICA_WEBHOOK_SECRET=secure_mzo_ematica_webhook_key_2026
EDUPORTAL_BASE_URL=https://postani-student.skolehr.xyz
EDUPORTAL_INTERNAL_BASE_URL=https://postani-student.skolehr.xyz
EDUPORTAL_INTEGRATION_SECRET=secure_eduportal_integration_key_2026

# Shared Supabase project used by e-Dnevnik/e-Matica/e-Upisi once real
# database-backed sync is enabled.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

